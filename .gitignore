build/
dist/

# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# --- X Article cookie auth (Section 6C) — a session token, never commit ---
x_cookies.txt

# --- Playwright MCP test artifacts (screenshots/snapshots from manual verification) ---
.playwright-mcp/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
